{
  "name": "@cstech/cc-custom-plugin-template-server",
  "version": "2026.23.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "generate": "drizzle-kit generate",
    "migrate": "bun --env-file=../.env src/db/migrate.ts",
    "validate-migrations": "bun src/scripts/validate-migrations.ts",
    "validate-plugin-manifest": "bun src/scripts/validate-plugin-manifest.ts",
    "audit-instances": "bun --env-file=../.env src/scripts/audit-instances.ts",
    "seed": "bun --env-file=../.env src/seed.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@staffbase/staffbase-plugin-sdk": "~1.3.1",
    "drizzle-orm": "^0.45",
    "hono": "^4",
    "image-size": "^2.0.2",
    "postgres": "^3.4",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "^1",
    "drizzle-kit": "^0.31",
    "typescript": "^6"
  }
}
