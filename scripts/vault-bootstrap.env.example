# Copy to scripts/vault-bootstrap.env, fill in real values, and run scripts/vault-bootstrap.sh.
# Plugin name is auto-detected from the git repo name (override via PLUGIN_NAME=...).
# scripts/vault-bootstrap.env is git-ignored — never commit real secrets.

# vault-bootstrap.env — values consumed by scripts/vault-bootstrap.sh
#
# Fill in PLUGIN_ID / PUBLIC_KEY / SECRET per env from Customer Control.
# Postgres passwords + ENCRYPTION_KEY are generated locally by the script;
# do NOT fill those in. They are read-back-from-Vault on re-runs (the script
# is idempotent — see header of vault-bootstrap.sh).
#
# After filling in: cp scripts/vault-bootstrap.env.example scripts/vault-bootstrap.env
# Then run: scripts/vault-bootstrap.sh <env-slug>
#   env-slug: dev-de1 | stage-de1 | prod-de1 | prod-au1 | prod-us1
#   (legacy aliases 'dev' and 'stage' still accepted)
#
# scripts/vault-bootstrap.env is git-ignored — never commit real secrets.

# ─── DEV/DE1 (Vault path: de1/dev/<PLUGIN_NAME>/...) ────────────────────────
DEV_PLUGIN_ID=""        # CuCu → Plugin Secrets → Plugin ID (UUID)
DEV_PUBLIC_KEY=""       # CuCu → Plugin Secrets → Public Key (RSA PEM, single line OK)
DEV_SECRET=""           # CuCu → Plugin Secrets → Secret (push notifications)

# ─── STAGE/DE1 (Vault path: de1/stage/<PLUGIN_NAME>/...) ────────────────────
STAGE_PLUGIN_ID=""
STAGE_PUBLIC_KEY=""
STAGE_SECRET=""

# ─── PROD/DE1 (Vault path: de1/prod/<PLUGIN_NAME>/...) ──────────────────────
PROD_DE1_PLUGIN_ID=""
PROD_DE1_PUBLIC_KEY=""
PROD_DE1_SECRET=""

# ─── PROD/AU1 (Vault path: au1/prod/<PLUGIN_NAME>/...) ──────────────────────
PROD_AU1_PLUGIN_ID=""
PROD_AU1_PUBLIC_KEY=""
PROD_AU1_SECRET=""

# ─── PROD/US1 (Vault path: us1/prod/<PLUGIN_NAME>/...) ──────────────────────
PROD_US1_PLUGIN_ID=""
PROD_US1_PUBLIC_KEY=""
PROD_US1_SECRET=""
