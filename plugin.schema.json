{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin Template Manifest",
  "type": "object",
  "required": ["name", "version", "entryPoints", "permissions", "scopes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_comment_pluginId": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "title": {
      "type": "object",
      "required": ["en_US"],
      "additionalProperties": { "type": "string" }
    },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "pluginId": { "type": "string" },
    "entryPoints": {
      "type": "object",
      "required": ["frontend", "backoffice", "api"],
      "additionalProperties": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "scopes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "storage": {
      "type": "object",
      "properties": {
        "database": { "type": "string" },
        "tables": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tagName", "title", "module"],
        "properties": {
          "tagName": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "module": { "type": "string" },
          "configAttributes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
